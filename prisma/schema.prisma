// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id        String   @id @default(uuid())
  usuario   String   @unique
  password  String
  nombre    String
  rol       String   @default("ADMIN") // "ADMIN", "READONLY"
  createdAt DateTime @default(now())
}

model Cliente {
  id               String         @id @default(uuid())
  nombreCompleto   String
  whatsapp         String
  email            String
  dni              String?        @unique
  fechaAlta        DateTime       @default(now())
  canalAdquisicion String         @default("ORGANICO") // "ORGANICO", "PUBLICIDAD_IG", "PUBLICIDAD_FB", "OTRO"
  estado           String         @default("ACTIVO") // "ACTIVO", "INACTIVO"
  frecuencia       Int            @default(4) // Frecuencia en semanas
  observaciones    String?
  notasGonzalo     String?
  fechaPrimerTurno DateTime?
  fechaNacimiento  DateTime?
  sesionesPrevias  Int            @default(0)
  enviarNotificaciones Boolean @default(true)
  turnos           Turno[]
  notificaciones   Notificacion[]
  conversaciones   ConversacionWsp[]
}

model Turno {
  id               String   @id @default(uuid())
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fecha            DateTime
  horaInicio       String   // "10:10"
  horaFin          String   // "10:40"
  duracionMinutos  Int
  zonas            String   // JSON stringified array of zones: '[{"nombre":"Espalda","precio":28000,"duracion":30}]'
  valorTotal       Float
  valorSeña        Float
  saldoPendiente   Float
  bonificacion     Float    @default(0)
  descuentoTipo    String?  @default("NINGUNO")
  descuentoValor   Float?   @default(0)
  estado           String   @default("PENDIENTE_PAGO") // "SEÑADO", "REALIZADO", "CANCELADO", "REPROGRAMADO", "NO_ASISTIO", "PENDIENTE_AUTORIZACION", "PENDIENTE_PAGO", "CONSULTA"
  señaEstado       String?  // "CONSERVADA", "PERDIDA"
  subEstado        String?  // "SIGUIENTE_TURNO", "VA_A_AVISAR", "MANTENIMIENTO", "FINALIZADO"
  enviarNotificaciones Boolean @default(true)
  observaciones    String?
  notasGonzalo     String?
  createdAt        DateTime @default(now())
}

model Bloqueo {
  id            String   @id @default(uuid())
  fecha         DateTime
  horaInicio    String   // "10:00"
  horaFin       String   // "20:00"
  motivo        String?
  esDiaCompleto Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Zona {
  id              String @id @default(uuid())
  nombre          String @unique
  precioBase      Float
  duracionMinutos Int
  señaBase        Float
}

model Notificacion {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  turnoId    String?
  fechaEnvio DateTime @default(now())
  canal      String   // "WHATSAPP", "EMAIL"
  mensaje    String
  estado     String   // "ENVIADO", "FALLIDO"
}

model Configuracion {
  key   String @id
  value String
}

// ==========================================
// MODELOS ESPECÍFICOS DE IA & WHATSAPP (SHARED DATABASE)
// ==========================================

model IaConfig {
  key         String   @id
  value       String
  descripcion String?
  updatedAt   DateTime @updatedAt
}

model IaHorario {
  id         String  @id @default(uuid())
  diaSemana  Int     @unique
  nombreDia  String
  activo     Boolean @default(true)
  horaInicio String  @default("09:00")
  horaFin    String  @default("20:00")
}

model ConversacionWsp {
  id                 String       @id @default(uuid())
  telefono           String       @unique
  nombreContacto     String?
  clienteId          String?
  cliente            Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  estadoIa           String       @default("ACTIVA")
  etiquetas          String?
  ultimoMensaje      String?
  ultimoMensajeFecha DateTime     @default(now())
  ultimoRemitente    String?
  mensajesNoLeidos   Int          @default(0)
  mensajes           MensajeWsp[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model MensajeWsp {
  id             String          @id @default(uuid())
  conversacionId String
  conversacion   ConversacionWsp @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  remitente      String
  texto          String
  timestamp      DateTime        @default(now())
  tokensUsados   Int?            @default(0)
  fueRespondido  Boolean         @default(true)
  metadata       String?
}

model IaFaq {
  id        String   @id @default(uuid())
  pregunta  String
  respuesta String
  categoria String   @default("GENERAL")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model IaDocumentoWeb {
  id                   String   @id @default(uuid())
  url                  String   @unique
  titulo               String
  seccion              String   @default("BLOG")
  contenidoTexto       String
  resumen              String?
  hash                 String
  activo               Boolean  @default(true)
  ultimaSincronizacion DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model IaSyncLog {
  id                  String   @id @default(uuid())
  tipo                String   @default("AUTO_CRON")
  estado              String   @default("SUCCESS")
  paginasTotal        Int      @default(0)
  paginasNuevas       Int      @default(0)
  preciosModificados  Int      @default(0)
  detalle             String?
  duracionMs          Int      @default(0)
  timestamp           DateTime @default(now())
}

